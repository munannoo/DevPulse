{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "node",
      "request": "launch",
      "noDebug": true,
      "runtimeExecutable": "node",
      "windows": { "runtimeExecutable": "${env:ProgramFiles}\\nodejs\\node.exe" },
      "env": {
        "NODE_OPTIONS": "",
        "VSCODE_INSPECTOR_OPTIONS": ""
      },
      "program": "${workspaceFolder}/scripts/launch-extension.mjs",
      "args": [
        "${execPath}",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "devpulse: compile"
    },
    {
      "name": "Run Extension (Native Debugger)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${workspaceFolder}/.vscode-test/dev-hosts/active-host",
        "--disable-extensions",
        "--disable-workspace-trust"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "devpulse: compile"
    }
  ]
}
