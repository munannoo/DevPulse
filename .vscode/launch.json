{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "node",
			"request": "attach",
			"address": "127.0.0.1",
			"port": 9333,
			"timeout": 30000,
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "devpulse: launch"
		}
	]
}
