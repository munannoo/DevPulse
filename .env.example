# Copy to .env in the project you open in VS Code. Never commit your .env.
# Replace localhost with your server's IP or cloud hostname, keeping its API path.
# LAN example: http://192.0.2.10:11434/v1
# Cloud example: https://ai.example.com/v1
DEVPULSE_LLM_BASE_URL=http://localhost:11434/v1
DEVPULSE_LLM_MODEL=gemma4:e4b
# Optional for CLI/server credentials. In VS Code prefer DevPulse: Set API Key.
DEVPULSE_LLM_API_KEY=
