{
  "name": "devpulse",
  "displayName": "Gemma DevPulse",
  "description": "Local-first developer context and pre-commit review.",
  "version": "0.0.1",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "devpulse.connectGitHub", "title": "DevPulse: Connect GitHub" },
      { "command": "devpulse.refreshPullRequests", "title": "DevPulse: Refresh Requested PRs" },
      { "command": "devpulse.reviewPullRequest", "title": "DevPulse: Review Pull Request", "enablement": "false" },
      { "command": "devpulse.cancelPullReview", "title": "DevPulse: Cancel PR Review" },
      { "command": "devpulse.openPanel", "title": "DevPulse: Open Panel" },
      { "command": "devpulse.openChat", "title": "DevPulse: Open Chat" },
      { "command": "devpulse.selectInlineModel", "title": "DevPulse: Select Autocomplete Model" },
      { "command": "devpulse.selectModel", "title": "DevPulse: Select Model (Review & Chat)" },
      { "command": "devpulse.generateCommitDescription", "title": "DevPulse: Generate Commit Description & Analysis" },
      { "command": "devpulse.clearAiCache", "title": "DevPulse: Clear AI Response Cache" },
      { "command": "devpulse.refreshAttention", "title": "DevPulse: Refresh Attention" },
      { "command": "devpulse.checkConnection", "title": "DevPulse: Check AI Connection" },
      { "command": "devpulse.installPrecommitAiHook", "title": "DevPulse: Install Pre-Commit Hook with AI Review" },
      { "command": "devpulse.disablePrecommitAi", "title": "DevPulse: Disable AI Pre-Commit Review" },
      { "command": "devpulse.explainSelection", "title": "DevPulse: Explain Selection" },
      { "command": "devpulse.fixSelection", "title": "DevPulse: Fix Selection" },
      { "command": "devpulse.writeTests", "title": "DevPulse: Write Tests" },
      { "command": "devpulse.resumeWork", "title": "DevPulse: Resume Where You Left Off" },
      { "command": "devpulse.pullAndSync", "title": "DevPulse: Git Pull & Sync" },
      { "command": "devpulse.applySuggestion", "title": "DevPulse: Apply Suggestion" },
      { "command": "devpulse.checkConnection", "title": "DevPulse: Check AI Connection" },
      {
        "command": "devpulse.helloWorld",
        "title": "DevPulse: Hello World"
      },
      {
        "command": "devpulse.reviewChanges",
        "title": "DevPulse: Review My Changes"
      },
      {
        "command": "devpulse.analyzeFile",
        "title": "DevPulse: Analyze File"
      },
      {
        "command": "devpulse.reviewSelection",
        "title": "DevPulse: Review Selection"
      },
      {
        "command": "devpulse.refreshBranch",
        "title": "DevPulse: Check Branch Status"
      },
      {
        "command": "devpulse.cancelReview",
        "title": "DevPulse: Cancel Review"
      },
      {
        "command": "devpulse.setApiKey",
        "title": "DevPulse: Set API Key"
      },
      {
        "command": "devpulse.verifyStaged",
        "title": "DevPulse: Verify Staged Changes"
      },
      {
        "command": "devpulse.installPrecommitHook",
        "title": "DevPulse: Install Pre-Commit Hook"
      },
      {
        "command": "devpulse.fixSecret",
        "title": "DevPulse: Fix Secret",
        "enablement": "false"
      },
      {
        "command": "devpulse.toggleInlineCompletion",
        "title": "DevPulse: Toggle Inline Autocomplete"
      },
      {
        "command": "devpulse.setBrikTheme",
        "title": "DevPulse: Switch to Brik Theme"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devpulse",
          "title": "DevPulse",
          "icon": "media/icons/devpulse.svg"
        }
      ]
    },
    "views": {
      "devpulse": [
        {
          "id": "devpulse.panel",
          "name": "DevPulse",
          "type": "webview"
        },
        {
          "type": "webview",
          "id": "devpulse.security",
          "name": "Security"
        }
      ]
    },
    "themes": [
      {
        "label": "DevPulse Brik Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/devpulse-brik-dark-color-theme.json"
      },
      {
        "label": "DevPulse Brik Light",
        "uiTheme": "vs",
        "path": "./themes/devpulse-brik-light-color-theme.json"
      }
    ],
    "configuration": {
      "title": "DevPulse",
      "properties": {
        "devpulse.focus.flowMinutes": { "type": "number", "default": 30, "minimum": 1, "maximum": 240,
          "description": "Continuous active minutes before the In Flow badge appears." },
        "devpulse.reminders.uncommittedMinutes": { "type": "number", "default": 1440, "minimum": 1, "maximum": 10080,
          "description": "Minutes uncommitted work must remain before DevPulse shows a reminder." },
        "devpulse.focus.shield": { "type": "boolean", "default": true,
          "description": "Delay DevPulse reminder toasts during Flow. Other extensions and apps are unaffected." },
        "devpulse.llm.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "scope": "machine",
          "description": "OpenAI-compatible server base URL, including /v1 when required. Environment and DevPulse .env take precedence."
        },
        "devpulse.llm.model": {
          "type": "string",
          "default": "gemma4:e4b",
          "scope": "machine",
          "description": "Exact model identifier installed on your self-hosted server."
        },
        "devpulse.llm.modelOverride": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Explicit editor model selection, overriding the environment and .env model. Empty restores normal configuration. CLI commands still use environment/.env."
        },
        "devpulse.llm.jsonMode": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Request JSON output. Disable for servers without response_format support; responses are always validated."
        },
        "devpulse.assistant.inline.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Enable or disable Gemma-powered inline code completions."
        },
        "devpulse.assistant.inline.model": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional model override for inline completion (e.g. gemma4:e2b). Empty uses the effective review/chat model."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "prebuild": "node scripts/check-node.cjs",
    "precompile": "node scripts/check-node.cjs",
    "prepackage": "node scripts/check-node.cjs",
    "prewatch": "node scripts/check-node.cjs",
    "vscode:prepublish": "npm run package",
    "compile": "node scripts/build-extension.mjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "node scripts/build-extension.mjs --verify --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && node scripts/build-extension.mjs --verify",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "node scripts/build-extension.mjs --verify --production",
    "test:core": "npm run compile-tests && node --test out/test/core/*.test.js",
    "test:security": "node scripts/test-security.mjs",
    "test:extension-security": "npm run compile-tests && node scripts/run-extension-security.mjs",
    "test:pr": "npm run compile-tests && npm run compile && node scripts/test-pr.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "license": "MIT"
}
