{
  "name": "devpulse",
  "displayName": "Gemma DevPulse",
  "description": "Local-first developer context and pre-commit review.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "devpulse", "title": "DevPulse", "icon": "media/mascot.svg" }]
    },
    "views": {
      "devpulse": [{ "type": "webview", "id": "devpulse.security", "name": "Security" }]
    },
    "commands": [
      { "command": "devpulse.verifyStaged", "title": "DevPulse: Verify Staged Changes" },
      { "command": "devpulse.installPrecommitHook", "title": "DevPulse: Install Pre-Commit Hook" },
      { "command": "devpulse.fixSecret", "title": "DevPulse: Fix Secret", "enablement": "false" },
      {
        "command": "devpulse.helloWorld",
        "title": "DevPulse: Hello World"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.mjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "npm run package",
    "test:security": "node scripts/test-security.mjs",
    "test:extension-security": "npm run compile-tests && node scripts/run-extension-security.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "license": "MIT"
}
